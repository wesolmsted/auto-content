# Copy to .env (gitignored) and fill in. Secrets come only from the environment (DESIGN.md §8).
# Any non-secret setting can also be overridden here as ACE_<SECTION>__<KEY>, e.g. ACE_RENDER__FPS=24.

# Where config/default.toml and config/local.toml live (default: ./config)
ACE_CONFIG_DIR=
# Root for the database, media store and secrets (default from config: ./data)
ACE_DATA_DIR=

# Google Drive: path to the OAuth client JSON downloaded from Google Cloud console
GOOGLE_OAUTH_CLIENT_JSON=

# Claude vision
ANTHROPIC_API_KEY=

# Meta Graph API (read-only)
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=

# TikTok Display API (read-only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ntfy phone notifications. The topic is a long random string; treat it as a secret.
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=

# Hand-off page: Tailscale URL and login token
HANDOFF_BASE_URL=
HANDOFF_TOKEN=
